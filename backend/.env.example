NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fashion_store?schema=public
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000

JWT_SECRET=replace-with-a-secure-secret-at-least-32-characters
JWT_EXPIRES_IN=1d
PASSWORD_SALT_ROUNDS=12
SEED_ADMIN_EMAIL=admin@fashionstore.com
SEED_ADMIN_PASSWORD=ChangeThisAdminPassword123!
