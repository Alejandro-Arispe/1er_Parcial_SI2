# API NestJS con prefijo /api/v1. En un telefono usa la IP de la computadora en la red,
# por ejemplo http://192.168.0.12:3000/api/v1 (localhost solo sirve en la vista web).
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
# true usa el backend simulado local (demo sin NestJS).
EXPO_PUBLIC_USE_MOCKS=false
